# Server
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
# Comma-separated dashboard origins allowed to call /api/*
CORS_ORIGINS=http://localhost:3000
# Local file, or /data/patchline.db on Maritime (persists across sleep)
DATABASE_URL=file:./data/patchline.db
# Protects /admin/* (min 24 chars)
ADMIN_TOKEN=

# Keiki
KEIKI_BASE_URL=https://onkeiki.com
KEIKI_API_KEY=
KEIKI_AGENT_ID=
KEIKI_WEBHOOK_SECRET=
# Shown at signup: how users start a chat with the agent (join link or number)
KEIKI_JOIN_LINK=
# Shared number only: join code prefixed to "start 123456" (e.g. K-7QF2MD). Empty for a dedicated line.
KEIKI_JOIN_CODE=
# The agent's iMessage number (E.164), used to build the sms: link / QR on the site
KEIKI_SMS_NUMBER=

# Where `npx skills add` installs the connect skill from (public GitHub repo with skills/patchline)
SKILLS_SOURCE=Iamritupatil/patchline
# Dev only: log tool-call header names + context keys to learn the payload shape
KEIKI_DEBUG=0

# LLM (Book 3)
ANTHROPIC_API_KEY=
